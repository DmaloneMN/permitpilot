{
  "openapi": "3.0.1",
  "info": {
    "title": "PermitPilot Plugin API",
    "version": "0.1.0",
    "description": "OpenAPI for PermitPilot Azure Function plugin. Use an API key in the x-api-key header."
  },
  "servers": [
    {
      "url": "https://your-azure-function-app.azurewebsites.net",
      "description": "Replace with your function host"
    }
  ],
  "paths": {
    "/api/permitpilot/process": {
      "post": {
        "summary": "Process an event through PermitPilot orchestration",
        "operationId": "processEvent",
        "tags": ["permitpilot"],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Event"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Processing result (approved / triage / error)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/permitpilot/feedback": {
      "post": {
        "summary": "Send human feedback for a previously processed item",
        "operationId": "sendFeedback",
        "tags": ["permitpilot"],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Feedback"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Feedback stored",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/permitpilot/health": {
      "get": {
        "summary": "Health check for the PermitPilot plugin",
        "operationId": "healthCheck",
        "tags": ["permitpilot"],
        "responses": {
          "200": {
            "description": "Healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "uptime_seconds": { "type": "number", "example": 12345.67 }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "Event": {
        "type": "object",
        "required": ["title", "body"],
        "properties": {
          "title": { "type": "string" },
          "body": { "type": "string" },
          "comments": {
            "type": "array",
            "items": { "type": "string" },
            "description": "List of recent comments for context (optional)"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "description": "Optional metadata (repo, issue number, permit id, location, etc.)"
          }
        }
      },
      "Result": {
        "type": "object",
        "properties": {
          "action": { "type": "string", "description": "post | triage-human | error" },
          "domain": { "type": "string", "description": "Resolved domain tag (e.g., legal, environmental)" },
          "draft": { "type": "string", "description": "Draft answer if action == post" },
          "review": { "type": "object", "additionalProperties": true },
          "classifier": { "type": "object", "additionalProperties": true },
          "used_docs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "error": { "type": "string" }
        }
      },
      "Feedback": {
        "type": "object",
        "required": ["item_id", "vote"],
        "properties": {
          "item_id": { "type": "string", "description": "ID of the processed item" },
          "vote": { "type": "string", "enum": ["up", "down"] },
          "comments": { "type": "string" },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Auto-labels like hallucination, tone_mismatch"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
